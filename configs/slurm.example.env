# Copy to configs/slurm.local.env (ignored), fill verified cluster values, then export ASR_SLURM_ENV.
export ASR_PROJECT_ROOT=/datastore/binhvp/BuiTrongTan/ASR
export ASR_DATA_ROOT=/datastore/binhvp/BuiTrongTan/data/train+public_test
